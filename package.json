{
  "name": "songbook",
  "version": "0.2.0-dev",
  "private": true,
  "description": "Native Nextcloud songbook for a band's shared ChordPro library",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch --mode development",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests/frontend vite.config.ts vitest.config.ts eslint.config.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.2.0",
    "@nextcloud/vue": "^9.14.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.3.14"
  }
}
