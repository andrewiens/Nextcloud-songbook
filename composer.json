{
    "name": "songbook/songbook",
    "description": "Native Nextcloud app for shared ChordPro songs and setlists",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.3 <8.6"
    },
    "require-dev": {
        "nextcloud/ocp": "^35.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "OCA\\Songbook\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\Songbook\\Tests\\": "tests/php/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/"
        }
    },
    "scripts": {
        "lint": "find appinfo lib templates tests/php -name '*.php' -print0 | xargs -0 -n 1 php -l",
        "test": "phpunit --configuration phpunit.xml"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
